{
  "name": "gif-style-windows",
  "version": "1.0.2",
  "description": "Standalone offline Windows desktop edition of GIF Style",
  "private": true,
  "main": "main.cjs",
  "scripts": {
    "stage": "node stage-assets.cjs",
    "start": "npm run stage && electron .",
    "dist:win": "npm run stage && electron-builder --win nsis --x64 --publish never"
  },
  "devDependencies": {
    "electron": "44.9.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.gifstyle.desktop",
    "productName": "GIF Style",
    "directories": {
      "output": "dist"
    },
    "asar": true,
    "files": [
      "main.cjs",
      "preload.cjs",
      "stage-assets.cjs",
      "package.json",
      "web/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "GIF Style"
    }
  }
}
